rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Only these emails may read every user's attendance data (admin screen).
    function isAdmin() {
      return request.auth != null && request.auth.token.email in [
        'kaori.takasu@pathoslogos.co.jp'
      ];
    }

    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    function isValidUserProfile() {
      let data = request.resource.data;
      return data.keys().hasOnly(['displayName', 'email'])
        && data.displayName is string
        && data.email is string;
    }

    function isValidAttendanceRecord() {
      let data = request.resource.data;
      let hasLocation = ('latitude' in data) && ('longitude' in data);
      let validKeys = hasLocation
        ? data.keys().hasOnly(['type', 'timestamp', 'latitude', 'longitude'])
        : data.keys().hasOnly(['type', 'timestamp']);
      return validKeys
        && data.type in ['clockIn', 'clockOut', 'breakStart', 'breakEnd']
        && data.timestamp is timestamp
        && (!('latitude' in data) || data.latitude is number)
        && (!('longitude' in data) || data.longitude is number);
    }
    
    function isValidRecordCorrection() {
      let before = resource.data;
      let after = request.resource.data;
      return after.type in ['clockIn', 'clockOut', 'breakStart', 'breakEnd']
        && after.timestamp is timestamp
        && after.correctedFrom == before.timestamp
        && after.keys().hasOnly(['type', 'timestamp', 'correctedFrom', 'latitude', 'longitude'])
        && (!('latitude' in after) || after.latitude is number)
        && (!('longitude' in after) || after.longitude is number);
    }

    function isValidCorrectionRequest() {
      let data = request.resource.data;
      return data.keys().hasOnly(['requestType', 'type', 'originalAt', 'correctedAt', 'reason', 'status', 'createdAt'])
        && data.requestType in ['modify', 'add', 'delete']
        && data.type in ['clockIn', 'clockOut', 'breakStart', 'breakEnd']
        && data.originalAt is timestamp
        && (!('correctedAt' in data) || data.correctedAt is timestamp)
        && data.reason is string
        && data.reason.size() <= 200
        && data.status == 'pending'
        && data.createdAt == request.time;
    }

    function isValidReview() {
      let before = resource.data;
      let after = request.resource.data;
      return before.status == 'pending'
        && after.status in ['approved', 'rejected']
        && after.requestType == before.requestType
        && after.type == before.type
        && after.originalAt == before.originalAt
        && after.correctedAt == before.correctedAt
        && after.reason == before.reason
        && after.createdAt == before.createdAt
        && after.keys().hasOnly(['requestType', 'type', 'originalAt', 'correctedAt', 'reason', 'status', 'createdAt', 'reviewedAt', 'reviewedBy'])
        && after.reviewedAt == request.time
        && after.reviewedBy is string;
    }

    // ▼ 個別ユーザーのデータルール
    match /users/{userId} {
      allow read: if request.auth != null;
      allow create, update: if isOwner(userId) && isValidUserProfile();
      allow delete: if false;

      match /attendanceRecords/{recordId} {
        allow read: if request.auth != null;
        allow create: if (isOwner(userId) || isAdmin()) && isValidAttendanceRecord();
        allow update: if isAdmin() && isValidRecordCorrection();
        allow delete: if false;
      }

      // Employee-submitted punch-correction requests, reviewed by the admin.
      match /correctionRequests/{requestId} {
        allow read: if isOwner(userId) || isAdmin();
        allow create: if isOwner(userId) && isValidCorrectionRequest();
        allow update: if isAdmin() && isValidReview();
        allow delete: if false;
      }

      // Notifications for each user
      match /notifications/{notificationId} {
        allow read: if isOwner(userId);
        allow write: if false;
      }
    }

    // ▼ 全ユーザーの出勤状況（attendanceRecords）を一括検索するための特別ルール
    match /{path=**}/attendanceRecords/{recordId} {
      allow read: if request.auth != null;
    }

    // ▼ （管理者用）修正申請の一括検索用ルール
    match /{path=**}/correctionRequests/{requestId} {
      allow read: if isAdmin();
    }

    // 35時間到達通知（Cloud Functions が作成）
    match /notifications/{notificationId} {
      allow read, write: if false;
    }

    // Deny everything else by default, including any future collections.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}